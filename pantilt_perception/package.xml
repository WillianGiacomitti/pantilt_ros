<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pantilt_perception</name>
  <version>0.1.0</version>
  <description>Percepção do pan-tilt: captura de imagem, detecção YOLO e calibração da câmera.</description>
  <maintainer email="willian@todo.com">Willian Luiz Giacomitti</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>pantilt_interfaces</exec_depend>
  <!-- ultralytics: pip (Dockerfile do pantilt_dockerfile), sem chave no rosdep -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
