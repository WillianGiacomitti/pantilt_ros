<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pantilt_dataset</name>
  <version>0.1.0</version>
  <description>Ferramenta auxiliar: gravação de vídeos para o dataset de treino da YOLO (capture_node).</description>
  <maintainer email="willian@todo.com">Willian Luiz Giacomitti</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>pantilt_interfaces</exec_depend>
  <!-- FrameThrottle (camera_source.py) -->
  <exec_depend>pantilt_perception</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
