<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pantilt_bringup</name>
  <version>0.1.0</version>
  <description>Integração do pan-tilt: launch files por camada e configuração (params.yaml, fastdds.xml).</description>
  <maintainer email="willian@todo.com">Willian Luiz Giacomitti</maintainer>
  <license>MIT</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Pacotes lançados pelos launch files -->
  <exec_depend>pantilt_hardware</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
